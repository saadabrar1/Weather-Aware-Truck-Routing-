# Copy to .env and fill in. Only DJANGO_SECRET_KEY is required in production.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with scheme) of the deployed site, comma separated.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional routing + geocoding keys; the first one set is used.
#   HERE: truck routing by exact gross weight.
#   Geoapify: truck routing by weight class (free tier, no card).
# With neither, the app uses the public OSRM and Photon servers.
HERE_API_KEY=
GEOAPIFY_API_KEY=

# Optional overrides
UPSTREAM_TIMEOUT_S=15
LOG_LEVEL=INFO
